# --- HTTP / Socket.io server ---
# Port the NestJS server listens on (default 3000).
PORT=3000
# Comma-separated list of allowed CORS origins (default http://localhost:3000).
CORS_ORIGIN=http://localhost:3000

# --- PostgreSQL question store (bring your own Postgres) ---
# All DB_* vars are required — the server refuses to start without them.
# Requires PostgreSQL 13+ (migration uses the built-in gen_random_uuid()).
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=family_feud
